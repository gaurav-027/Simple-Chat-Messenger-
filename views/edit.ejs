<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Messenger</title>
    <link rel="stylesheet" href="style.css">
</head>
<style>
    .new{
    margin: 0px 10px 10px 10px;
    padding: 5px 5px;
    height: 40px;
    width: 100px;
    border-radius: 10px;background-color: aqua;
}
body{
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .body{
        background-color: rgba(0, 0, 0, 0.15);
        box-shadow: 5px 5px 10px gray;
        padding: 10px;
        text-align: center;
        width: 20%;
    }
    
    input{
        border:none;
        border-radius: 5px;
        height: 50px;
        width: 150px;
    }
    .edit{
        margin: 0px 10px 10px 10px;
        padding: 5px 10px;
        border-radius: 5px;
        background-color: azure;
    }
</style>
<body>
    <div class="body">
        <h2>Edit your chat</h2>
        <p>This chat was sent from <b><%= chats.from %></b> to <b><%= chats.to %></b> </p>

        <form method="post" action="/chats/<%= chats.id %>?_method=put">
            <textarea name="msg" rows="5" cols="30"><%= chats.msg %></textarea>
            <br><br>
            <button class="new">Edit</button>
        </form>
    </div>
</body>
</html>